{
  "name": "@tezosx/wallet",
  "private": true,
  "version": "0.17.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/postbuild-manifest.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts",
    "test:e2e:ci": "playwright test --config=e2e/playwright.config.ts",
    "test:e2e:record": "RECORD=1 playwright test --config=e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test --config=e2e/playwright.config.ts --ui",
    "e2e:gen-vault": "tsx e2e/scripts/gen-vault.ts",
    "pretest:e2e": "npm run build"
  },
  "dependencies": {
    "@noble/ciphers": "1.2.1",
    "@noble/curves": "2.2.0",
    "@noble/hashes": "2.2.0",
    "@scure/bip39": "^2.2.0",
    "@taquito/rpc": "^24.3.0",
    "@taquito/signer": "^24.3.0",
    "@taquito/taquito": "^24.3.0",
    "@tezosx/relayer": "^0.8.0",
    "@tezosx/wallet-core": "^0.7.0",
    "buffer": "^6.0.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-qr-code": "^2.2.0",
    "react-router-dom": "^7.14.2"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.4.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.2.4",
    "@types/chrome": "^0.1.40",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.22.4",
    "vite": "^8.0.10",
    "vitest": "^3.2.4"
  }
}
