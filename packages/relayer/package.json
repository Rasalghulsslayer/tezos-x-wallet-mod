{
  "name": "@tezosx/relayer",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./provider": "./src/provider.ts",
    "./wallet-client": "./src/wallet-client.ts",
    "./gateway": "./src/gateway.ts",
    "./tezlink": "./src/tezlink.ts",
    "./constants": "./src/constants.ts",
    "./types": "./src/types.ts",
    "./utils/*": "./src/utils/*.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node build.mjs",
    "build:ext": "cd extension && node build.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:ext": "tsc --noEmit -p extension/tsconfig.json",
    "lint": "eslint src extension/src",
    "serve": "npx serve --cors -l 8080 .",
    "dev:ext": "web-ext run --source-dir extension --target chromium"
  },
  "dependencies": {
    "@airgap/beacon-sdk": "^4.8.1",
    "@taquito/michel-codec": "^24.2.0",
    "@taquito/rpc": "^24.2.0",
    "@taquito/taquito": "^24.2.0",
    "eventemitter3": "^5.0.4",
    "lucide-react": "^1.8.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "viem": "^2.47.2"
  }
}
