{
  "compilerOptions": {
    "target":             "ES2022",
    "module":             "ESNext",
    "moduleResolution":   "bundler",
    "lib":                ["ES2022", "DOM", "DOM.Iterable"],
    "rootDir":            "./src",
    "strict":             true,
    "isolatedModules":    true,
    "skipLibCheck":       true,
    "noEmit":             true,
    "noUnusedLocals":     true,
    "noUnusedParameters": true,
    "resolveJsonModule":  true
  },
  "include": ["src"]
}
