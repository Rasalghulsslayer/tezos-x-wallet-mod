{
  "name": "@tezosx/wallet-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./domain": "./src/domain/index.ts",
    "./domain/*": "./src/domain/*.ts",
    "./ports": "./src/ports/index.ts",
    "./ports/*": "./src/ports/*.ts",
    "./shared/evm-signing": "./src/shared/evm-signing/index.ts",
    "./shared/evm-signing/*": "./src/shared/evm-signing/*.ts",
    "./shared/*": "./src/shared/*.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@noble/curves": "2.2.0",
    "@noble/hashes": "2.2.0",
    "@scure/bip39": "^2.2.0",
    "@taquito/signer": "^24.3.0",
    "@tezosx/relayer": "^0.6.0",
    "buffer": "^6.0.3"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  }
}
