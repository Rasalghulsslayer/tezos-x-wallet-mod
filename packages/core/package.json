{
  "name": "@tezosx/wallet-core",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./domain": "./src/domain/index.ts",
    "./domain/*": "./src/domain/*.ts",
    "./ports": "./src/ports/index.ts",
    "./ports/*": "./src/ports/*.ts",
    "./shared/evm-signing": "./src/shared/evm-signing/index.ts",
    "./shared/evm-signing/*": "./src/shared/evm-signing/*.ts",
    "./shared/*": "./src/shared/*.ts",
    "./adapters/*": "./src/adapters/*.ts",
    "./composition/*": "./src/composition/*.ts",
    "./view-models/*": "./src/view-models/*.ts",
    "./use-cases/*": "./src/use-cases/*.ts",
    "./keyring": "./src/background/keyring.ts",
    "./approval-queue": "./src/background/approval-queue.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@noble/curves": "2.2.0",
    "@noble/hashes": "2.2.0",
    "@scure/bip32": "^2.2.0",
    "@scure/bip39": "^2.2.0",
    "@taquito/rpc": "^24.3.0",
    "@taquito/signer": "^24.3.0",
    "@taquito/taquito": "^24.3.0",
    "@tezosx/relayer": "^0.7.0",
    "buffer": "^6.0.3",
    "eventemitter3": "^5.0.4"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  }
}
