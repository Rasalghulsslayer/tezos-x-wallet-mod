{
  // Editor-only tsconfig (Docusaurus compiles via its own tooling).
  "compilerOptions": {
    "allowJs":             true,
    "esModuleInterop":     true,
    "jsx":                 "react-jsx",
    "target":              "ES2022",
    "lib":                 ["ES2022", "DOM"],
    "moduleResolution":    "bundler",
    "module":              "esnext",
    "noEmit":              true,
    "resolveJsonModule":   true,
    "skipLibCheck":        true,
    "paths": {
      "@site/*": ["./*"]
    }
  },
  "include": ["src", "docs", "versioned_docs", "docusaurus.config.ts", "sidebars.ts"],
  "exclude": [".docusaurus", "build", "node_modules"]
}
